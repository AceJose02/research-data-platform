# Copy to .env (or export in your shell). All values are optional.

# Where the API listens
RDP_HOST=127.0.0.1
RDP_PORT=5000

# Never enable on a server reachable by others: the Werkzeug debugger allows code execution.
FLASK_DEBUG=0

# Uploads
RDP_MAX_UPLOAD_MB=50
RDP_DATA_DIR=./data
RDP_DATASET_TTL_HOURS=24
RDP_CACHE_SIZE=8

# Browser origins allowed to call the API directly (comma-separated).
# Not needed in development: the Vite dev server proxies /api.
RDP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
