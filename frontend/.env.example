# Where `npm run dev` forwards /api requests (the Flask backend).
VITE_PROXY_TARGET=http://127.0.0.1:5000

# Only set this if the built frontend is hosted separately from the API,
# e.g. VITE_API_URL=https://api.example.com (then add that origin's
# frontend URL to RDP_CORS_ORIGINS on the backend).
# VITE_API_URL=
